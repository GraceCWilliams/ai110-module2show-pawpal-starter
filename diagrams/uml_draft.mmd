classDiagram
    %% Initial design draft, made before implementation (see reflection.md section 1a).
    %% The final design that matches pawpal_system.py is in uml.mmd (also saved as uml_final.mmd).

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet) None
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~str~ special_needs
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str preferred_time
        +str frequency
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~Task~
        +explain_plan() str
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
