classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Optional~Pet~
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +date due_date
        +str pet_name
        +mark_complete() Optional~Task~
        +start_minutes() int
        +end_minutes() int
    }

    class Scheduler {
        +Owner owner
        +get_tasks_for_date(day) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +find_conflicts(tasks) list~tuple~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(task) Optional~Task~
        +generate_daily_plan(day) tuple
        +explain_plan(day) str
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> "1" Owner : plans for
    Task ..> Pet : pet_name links back by name
    Task ..> Task : mark_complete() creates next occurrence
